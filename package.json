{
    "name": "astro-netlify-platform-starter",
    "type": "module",
    "version": "0.1.0",
    "engines": {
        "node": ">=22.23.4"
    },
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "check": "astro check",
        "test": "vitest run",
        "test:known-defects": "vitest run --config vitest.known-defects.config.ts",
        "check:demo-off": "node scripts/check-demo-build.mjs off",
        "check:demo-on": "node scripts/check-demo-build.mjs on",
        "check:secrets": "node scripts/check-secrets.mjs",
        "lint:api": "redocly lint docs/api/openapi.yaml",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@astrojs/netlify": "^8.2.14",
        "@astrojs/react": "^7.1.9",
        "@astrojs/sitemap": "^3.7.6",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "@fontsource/tajawal": "^5.3.0",
        "@netlify/blobs": "^11.1.11",
        "@netlify/cache": "^4.2.2",
        "@tailwindcss/vite": "^4.3.5",
        "astro": "^7.4.13",
        "blobshape": "^1.0.0",
        "marked": "^18.3.0",
        "marked-shiki": "^1.2.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.1.16",
        "unique-names-generator": "^4.7.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@redocly/cli": "2.83.0",
        "@types/blobshape": "^1.0.3",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "^3.10.1",
        "prettier-plugin-astro": "^1.1.2",
        "typescript": "^6.0.3",
        "vitest": "^5.1.1",
        "yaml": "2.9.1"
    }
}
