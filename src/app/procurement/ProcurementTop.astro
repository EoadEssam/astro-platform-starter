---
// Top of every procurement prototype page: the deferred notice, the cycle, and the three tabs.
import type { Lang } from '../i18n';
import { ACT, PT } from './text';
import { PROCUREMENT_ROLES } from '../sample/procurement';

interface Props {
    lang: Lang;
    current: 'requests' | 'orders' | 'receipts';
}
const { lang, current } = Astro.props;
const tabs = [
    ['requests', PT.requests],
    ['orders', PT.orders],
    ['receipts', PT.receipts]
] as const;
---

<div class="ptop">
    <p class="ptop__deferred">
        <strong>{PT.deferredTag[lang]}.</strong> {PT.deferredNote[lang]}
    </p>
    <p class="ptop__cycle">
        {PT.cycle[lang]} {PT.duties[lang]}
    </p>
    <div class="ptop__session">
        <p>{ACT.session[lang]}</p>
        <button type="button" class="pbtn" data-proc-reset>
            {ACT.reset[lang]}
        </button>
    </div>
    <nav class="ptop__tabs" aria-label={PT.group[lang]}>
        <ul>
            {tabs.map(([id, label]) => (
                <li data-roles={PROCUREMENT_ROLES[id].join(',')}>
                    <a href={`/${lang}/procurement/${id}/`} aria-current={current === id ? 'page' : undefined}>
                        {label[lang]}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</div>

<style>
    .ptop {
        display: grid;
        gap: 10px;
    }
    .ptop__deferred {
        margin: 0;
        padding: 12px 16px;
        border-radius: var(--ambs-radius-sm);
        background: var(--ambs-quiet-bg);
        color: var(--ambs-ink);
        border-inline-start: 4px solid var(--ambs-brand);
    }
    .ptop__cycle {
        margin: 0;
        color: var(--ambs-muted);
        font-size: 0.9375rem;
    }
    .ptop__session {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 14px;
        border-radius: var(--ambs-radius-sm);
        border: 1px dashed var(--ambs-line);
        background: var(--ambs-surface);
    }
    .ptop__session p {
        margin: 0;
        flex: 1 1 320px;
        font-size: 0.9375rem;
    }
    .ptop__tabs ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .ptop__tabs a {
        display: inline-flex;
        align-items: center;
        min-height: var(--ambs-touch);
        padding: 0 16px;
        border-radius: 999px;
        border: 1px solid var(--ambs-line);
        background: var(--ambs-surface);
        color: var(--ambs-ink);
        font-weight: 700;
        text-decoration: none;
    }
    .ptop__tabs a[aria-current='page'] {
        background: var(--ambs-brand);
        border-color: var(--ambs-brand);
        color: var(--ambs-on-brand);
    }
</style>
