---
// The earlier prototype's project pages (/[lang]/projects/s1/ … s8/, SAMPLE data of src/app/sample/projects.ts).
// Review round 9, item 2: they send to the S2 projects screen, because their identifiers belong to the old sample and
// have no record in the contract's data to point to. public/_redirects answers 301 for each of them; this page stays as
// the meta refresh fallback. The sample files are kept for the template's tests.
import Document from '../../../app/layouts/Document.astro';
import { languages, t, type Lang } from '../../../app/i18n';
import { SAMPLE_PROJECTS } from '../../../app/sample/projects';

export const getStaticPaths = () => languages.flatMap((lang) => SAMPLE_PROJECTS.map((p) => ({ params: { lang, id: p.id } })));

const lang = Astro.params.lang as Lang;
const to = `/${lang}/projects/`;
---

<Document lang={lang} title={t(lang, 'projects.title')}>
    <meta slot="head" http-equiv="refresh" content={`0; url=${to}`} />
    <link slot="head" rel="canonical" href={to} />
    <main class="moved">
        <p>
            {t(lang, 'module.moved')} <a href={to}>{to}</a>
        </p>
    </main>
</Document>
