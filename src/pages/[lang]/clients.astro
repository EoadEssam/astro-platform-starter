---
// S2 screen (contract 1.2.0, approved 2026-11-21): clients. SAMPLE DATA from the contract's examples, served by a mock
// in the tab. Drawn by src/app/s2/screens/clients.ts through the single access layer (src/app/api/client.ts): both
// headers on every change, the generation guard, my_permissions, and a refresh after permission_denied.
import AppLayout from '../../app/layouts/AppLayout.astro';
import S1Shell from '../../app/components/S1Shell.astro';
import { languages, t, type Lang } from '../../app/i18n';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
---

<AppLayout lang={lang} title={t(lang, 'nav.clients')} current="clients" s1>
    <S1Shell lang={lang} title="nav.clients" subtitle="s2.clients.subtitle" />
</AppLayout>

<script>
    import '../../app/s2/screens/clients';
</script>
