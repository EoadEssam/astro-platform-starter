---
// S3 screen (contract 1.3.0): one expense, named by ?id= (static page). SAMPLE DATA from the contract's examples. Drawn by
// src/app/s3/screens/expense.ts through the single access layer; the server's scope decides whether the expense exists
// for the caller (404 outside it).
import AppLayout from '../../../app/layouts/AppLayout.astro';
import S1Shell from '../../../app/components/S1Shell.astro';
import { languages, t, type Lang } from '../../../app/i18n';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
---

<AppLayout lang={lang} title={t(lang, 'expense.title')} current="expenses" s1>
    <S1Shell lang={lang} title="expense.title" subtitle="expense.subtitle" />
</AppLayout>

<script>
    import '../../../app/s3/screens/expense';
</script>
