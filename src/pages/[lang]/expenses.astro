---
// Expenses (S3, contract 1.3.0, approved 2026-11-26): GET /expenses through the single access layer, on SAMPLE DATA from
// the contract's examples served by a mock in the tab. Filtered on the server by the scope of the grant: a project
// manager sees the expenses of its assigned projects; a site engineer has no financial access (403).
import AppLayout from '../../app/layouts/AppLayout.astro';
import S1Shell from '../../app/components/S1Shell.astro';
import { languages, t, type Lang } from '../../app/i18n';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
---

<AppLayout lang={lang} title={t(lang, 'expenses.title')} current="expenses" s1>
    <S1Shell lang={lang} title="expenses.title" subtitle="expenses.subtitle" />
</AppLayout>

<script>
    import '../../app/s3/screens/expenses';
</script>
