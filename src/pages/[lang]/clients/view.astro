---
// S2 screen (contract 1.2.0): one client, named by ?id= (static page). SAMPLE DATA from the contract's examples.
// Drawn by src/app/s2/screens/client.ts through the single access layer.
import AppLayout from '../../../app/layouts/AppLayout.astro';
import S1Shell from '../../../app/components/S1Shell.astro';
import { languages, t, type Lang } from '../../../app/i18n';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
---

<AppLayout lang={lang} title={t(lang, 's2.client.title')} current="clients" s1>
    <S1Shell lang={lang} title="s2.client.title" subtitle="s2.detail.subtitle" />
</AppLayout>

<script>
    import '../../../app/s2/screens/client';
</script>
