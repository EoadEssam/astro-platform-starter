---
// S1 screen, SAMPLE DATA from the approved contract's examples (docs/api/openapi.yaml 1.0.0) served by a mock in the tab.
// Roles and permissions, read-only: GET /roles, GET /permissions (D-API-1).
// The content is drawn by src/app/s1/screens/roles.ts through the single access layer (src/app/api/client.ts).
import AppLayout from '../../../app/layouts/AppLayout.astro';
import S1Shell from '../../../app/components/S1Shell.astro';
import { languages, t, type Lang } from '../../../app/i18n';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
---

<AppLayout lang={lang} title={t(lang, 'nav.company.roles')} current="company-roles" s1>
    <S1Shell lang={lang} title="nav.company.roles" subtitle="roles.subtitle" />
</AppLayout>

<script>
    import '../../../app/s1/screens/roles';
</script>
