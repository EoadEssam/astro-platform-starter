---
// Dashboard (review round 9, item 2). Read from GET /projects (contract 1.2.0) through the single access layer, on SAMPLE
// DATA from the contract's examples, so it follows the server's scope like every S2 screen. Counts only, no amounts.
// The earlier prototype's sample figures (src/app/sample/*) stay in the repository for the template's tests.
import AppLayout from '../../app/layouts/AppLayout.astro';
import S1Shell from '../../app/components/S1Shell.astro';
import { languages, t, type Lang } from '../../app/i18n';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
---

<AppLayout lang={lang} title={t(lang, 'dashboard.title')} current="dashboard" s1>
    <S1Shell lang={lang} title="dashboard.title" subtitle="dashboard.subtitle" />
</AppLayout>

<script>
    import '../../app/s2/screens/dashboard';
</script>
