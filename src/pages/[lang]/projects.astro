---
// Projects (S2, contract 1.2.0, approved 2026-11-21). This page replaces the earlier prototype list, which said it would
// become GET /projects through the gateway: it now reads GET /projects through the single access layer, on SAMPLE DATA
// from the contract's examples served by a mock in the tab. The list is filtered on the server by the scope of the
// grant: a site engineer sees the projects they are assigned to, and nothing else.
// The contract-state preview (?state=<id>) stays on this page (src/app/states/catalog.ts, SCREEN_PATH.app).
import AppLayout from '../../app/layouts/AppLayout.astro';
import S1Shell from '../../app/components/S1Shell.astro';
import StatePreview from '../../app/components/StatePreview.astro';
import { languages, t, type Lang } from '../../app/i18n';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
---

<AppLayout lang={lang} title={t(lang, 'projects.title')} current="projects" s1>
    <StatePreview screen="app" lang={lang} here={`/${lang}/projects/`} />
    <S1Shell lang={lang} title="projects.title" subtitle="s2.projects.subtitle" />
</AppLayout>

<script>
    import '../../app/s2/screens/projects';
</script>
