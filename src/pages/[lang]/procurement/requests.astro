---
// Material requests, WALKABLE PROCUREMENT PROTOTYPE (deferred module; interface only, owner request 2026-11-19).
import ProcurementPage from '../../../app/procurement/ProcurementPage.astro';
import { languages, type Lang } from '../../../app/i18n';
import { PT } from '../../../app/procurement/text';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---

<ProcurementPage
    lang={lang}
    title={PT.requests[lang]}
    tab="requests"
    view="requests"
    heading={{ title: PT.requests[lang], sub: `${PT.requestsSub[lang]}. ${PT.freeText[lang]}` }}
/>
