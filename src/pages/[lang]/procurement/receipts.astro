---
// Goods receipts and orders awaiting delivery, WALKABLE PROCUREMENT PROTOTYPE. No prices.
import ProcurementPage from '../../../app/procurement/ProcurementPage.astro';
import { languages, type Lang } from '../../../app/i18n';
import { PT } from '../../../app/procurement/text';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---

<ProcurementPage lang={lang} title={PT.receipts[lang]} tab="receipts" view="receipts" heading={{ title: PT.receipts[lang], sub: PT.receiptsSub[lang] }} />
