---
// Goods receipts, PROCUREMENT DESIGN PROTOTYPE with SAMPLE DATA (src/app/sample/procurement.ts).
// What reached the site, recorded by the site engineer and confirmed by the project manager. No prices here.
import AppLayout from '../../../app/layouts/AppLayout.astro';
import ProcurementTop from '../../../app/procurement/ProcurementTop.astro';
import { languages, type Lang } from '../../../app/i18n';
import { PT, RECEIPT_STATUS, ROLE_TEXT } from '../../../app/procurement/text';
import { projectOf } from '../../../app/procurement/lookup';
import { PROCUREMENT_ROLES, SAMPLE_ORDERS, SAMPLE_RECEIPTS, UNITS } from '../../../app/sample/procurement';
import '../../../app/procurement/table.css';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---

<AppLayout lang={lang} title={PT.receipts[lang]} current="proc-receipts">
    <div data-denied hidden>
        <p>{PT.deferredNote[lang]}</p>
    </div>
    <div data-guard={PROCUREMENT_ROLES.receipts.join(',')} class="pstack">
        <ProcurementTop lang={lang} current="receipts" />
        <div class="phead">
            <h1>{PT.receipts[lang]}</h1>
            <p>{PT.receiptsSub[lang]}</p>
        </div>
        <div class="pstack" data-company-list>
            <p class="pempty" data-pempty hidden>
                {PT.empty[lang]}
            </p>
            <div class="ptable-wrap">
                <table class="ptable">
                    <thead>
                        <tr>
                            <th scope="col">{PT.no[lang]}</th>
                            <th scope="col">{PT.order[lang]}</th>
                            <th scope="col">{PT.project[lang]}</th>
                            <th scope="col">{PT.date[lang]}</th>
                            <th scope="col">{PT.items[lang]}</th>
                            <th scope="col">{PT.receivedBy[lang]}</th>
                            <th scope="col">{PT.status[lang]}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {SAMPLE_RECEIPTS.map((r) => {
                            const o = SAMPLE_ORDERS.find((x) => x.id === r.order)!;
                            const p = projectOf(o.project);
                            const st = RECEIPT_STATUS[r.status];
                            return (
                                <tr data-company={p.company}>
                                    <td class="ambs-latin" dir="ltr">
                                        {r.id}
                                        <div class="muted">{r.deliveryNote}</div>
                                    </td>
                                    <td>
                                        <a
                                            href={`/${lang}/procurement/orders/${o.id}/`}
                                            class="ambs-latin"
                                            dir="ltr"
                                            data-roles-link={PROCUREMENT_ROLES.orders.join(',')}
                                        >
                                            {o.id}
                                        </a>
                                        <div class="muted">{o.supplier[lang]}</div>
                                    </td>
                                    <td>
                                        {p.name[lang]}
                                        <div class="muted ambs-latin" dir="ltr">
                                            {p.code}
                                        </div>
                                    </td>
                                    <td class="ambs-latin" dir="ltr">
                                        {r.date}
                                    </td>
                                    <td>
                                        <ul>
                                            {r.lines.map((x) => (
                                                <li>
                                                    {o.lines[x.line].item[lang]}: {PT.delivered[lang]} <span dir="ltr">{x.delivered}</span>{' '}
                                                    {UNITS[o.lines[x.line].unit][lang]}
                                                    {x.rejected > 0 && (
                                                        <span>
                                                            {' '}
                                                            · {PT.rejected[lang]} <span dir="ltr">{x.rejected}</span> ({x.reason?.[lang]})
                                                        </span>
                                                    )}
                                                </li>
                                            ))}
                                        </ul>
                                    </td>
                                    <td>{ROLE_TEXT[r.receivedBy][lang]}</td>
                                    <td>
                                        <span class:list={['ambs-pill', `ambs-pill--${st.pill}`]}>{st.text[lang]}</span>
                                        {r.confirmedBy && (
                                            <div class="muted">
                                                {PT.confirmedBy[lang]}: {ROLE_TEXT[r.confirmedBy][lang]}
                                            </div>
                                        )}
                                    </td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</AppLayout>
