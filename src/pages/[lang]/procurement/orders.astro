---
// Purchase orders, WALKABLE PROCUREMENT PROTOTYPE. Orders carry amounts: hidden from the site engineer.
import ProcurementPage from '../../../app/procurement/ProcurementPage.astro';
import { languages, type Lang } from '../../../app/i18n';
import { PT } from '../../../app/procurement/text';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---

<ProcurementPage lang={lang} title={PT.orders[lang]} tab="orders" view="orders" heading={{ title: PT.orders[lang], sub: PT.ordersSub[lang] }} />
