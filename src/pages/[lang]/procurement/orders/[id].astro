---
// One purchase order, PROCUREMENT DESIGN PROTOTYPE with SAMPLE DATA (src/app/sample/procurement.ts).
// Lines with ordered / accepted / awaiting confirmation / remaining, the amounts before tax with a VAT line for
// display only (owner decision, option A), the deliveries, and the approval trail. Matching the supplier invoice
// is deferred (C17) and only named here.
import AppLayout from '../../../../app/layouts/AppLayout.astro';
import ProcurementTop from '../../../../app/procurement/ProcurementTop.astro';
import { languages, type Lang } from '../../../../app/i18n';
import { ORDER_STATUS, PT, RECEIPT_STATUS, ROLE_TEXT } from '../../../../app/procurement/text';
import { projectOf } from '../../../../app/procurement/lookup';
import {
    PROCUREMENT_ROLES,
    SAMPLE_ORDERS,
    UNITS,
    VAT_DISPLAY_RATE_PERCENT,
    acceptedQty,
    awaitingQty,
    formatMoney,
    lineTotal,
    receiptsOf,
    remainingQty,
    subtotal,
    vatDisplay
} from '../../../../app/sample/procurement';
import '../../../../app/procurement/table.css';

export const getStaticPaths = () => languages.flatMap((lang) => SAMPLE_ORDERS.map((o) => ({ params: { lang, id: o.id } })));

const lang = Astro.params.lang as Lang;
const o = SAMPLE_ORDERS.find((x) => x.id === Astro.params.id)!;
const p = projectOf(o.project);
const st = ORDER_STATUS[o.status];
const receipts = receiptsOf(o.id);
const sub = subtotal(o);
const vat = vatDisplay(o);
const showReceiving = !['draft', 'submitted', 'cancelled'].includes(o.status);
---

<AppLayout lang={lang} title={`${o.id} · ${PT.orders[lang]}`} current="proc-orders">
    <div data-denied hidden class="pstack">
        <ProcurementTop lang={lang} current="orders" />
        <p>{PT.deniedOrders[lang]}</p>
    </div>
    <div data-guard={PROCUREMENT_ROLES.orders.join(',')} class="pstack">
        <ProcurementTop lang={lang} current="orders" />
        <a class="back" href={`/${lang}/procurement/orders/`}>
            {PT.back[lang]}
        </a>

        <div class="phead">
            <h1 class="ambs-latin" dir="ltr">
                {o.id}
            </h1>
            <p>
                {p.name[lang]} · <span dir="ltr">{p.code}</span> · {PT.supplier[lang]}: {o.supplier[lang]} · {PT.expected[lang]}:
                <span dir="ltr">{o.expectedDelivery}</span>
            </p>
            <p>
                <span class:list={['ambs-pill', `ambs-pill--${st.pill}`]}>{st.text[lang]}</span>
                {o.reason && <span> {o.reason[lang]}</span>}
            </p>
        </div>

        <section class="pstack">
            <h2>{PT.items[lang]}</h2>
            <div class="ptable-wrap">
                <table class="ptable">
                    <thead>
                        <tr>
                            <th scope="col">{PT.item[lang]}</th>
                            <th scope="col">{PT.unit[lang]}</th>
                            <th scope="col" class="num">
                                {PT.ordered[lang]}
                            </th>
                            {showReceiving && (
                                <th scope="col" class="num">
                                    {PT.accepted[lang]}
                                </th>
                            )}
                            {showReceiving && (
                                <th scope="col" class="num">
                                    {PT.awaiting[lang]}
                                </th>
                            )}
                            {showReceiving && (
                                <th scope="col" class="num">
                                    {PT.remaining[lang]}
                                </th>
                            )}
                            <th scope="col" class="num">
                                {PT.unitPrice[lang]}
                            </th>
                            <th scope="col" class="num">
                                {PT.lineTotal[lang]}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {o.lines.map((ln, i) => (
                            <tr>
                                <td>{ln.item[lang]}</td>
                                <td>{UNITS[ln.unit][lang]}</td>
                                <td class="num">{ln.qty}</td>
                                {showReceiving && <td class="num">{acceptedQty(o, i)}</td>}
                                {showReceiving && <td class="num">{awaitingQty(o, i) || '—'}</td>}
                                {showReceiving && <td class="num">{remainingQty(o, i)}</td>}
                                <td class="num">{formatMoney(ln.unitPrice, lang)}</td>
                                <td class="num">{formatMoney(lineTotal(ln), lang)}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <dl class="totals">
                <div>
                    <dt>{PT.subtotal[lang]}</dt>
                    <dd class="num">{formatMoney(sub, lang)}</dd>
                </div>
                <div class="totals__vat">
                    <dt>
                        {PT.vat[lang]} <span dir="ltr">{VAT_DISPLAY_RATE_PERCENT}%</span>
                        <small>{PT.vatNote[lang]}</small>
                    </dt>
                    <dd class="num">{formatMoney(vat, lang)}</dd>
                </div>
                <div class="totals__total">
                    <dt>{PT.total[lang]}</dt>
                    <dd class="num">{formatMoney(sub + vat, lang)}</dd>
                </div>
            </dl>
        </section>

        {showReceiving && (
            <section class="pstack">
                <h2>{PT.deliveries[lang]}</h2>
                {receipts.length === 0 ? (
                    <p class="pempty">{PT.noDeliveries[lang]}</p>
                ) : (
                    <div class="ptable-wrap">
                        <table class="ptable">
                            <thead>
                                <tr>
                                    <th scope="col">{PT.no[lang]}</th>
                                    <th scope="col">{PT.date[lang]}</th>
                                    <th scope="col">{PT.items[lang]}</th>
                                    <th scope="col">{PT.receivedBy[lang]}</th>
                                    <th scope="col">{PT.status[lang]}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {receipts.map((r) => (
                                    <tr>
                                        <td class="ambs-latin" dir="ltr">
                                            {r.id}
                                            <div class="muted">{r.deliveryNote}</div>
                                        </td>
                                        <td class="ambs-latin" dir="ltr">
                                            {r.date}
                                        </td>
                                        <td>
                                            <ul>
                                                {r.lines.map((x) => (
                                                    <li>
                                                        {o.lines[x.line].item[lang]}: {PT.delivered[lang]} <span dir="ltr">{x.delivered}</span>
                                                        {x.rejected > 0 && (
                                                            <span>
                                                                {' '}
                                                                · {PT.rejected[lang]} <span dir="ltr">{x.rejected}</span> ({x.reason?.[lang]})
                                                            </span>
                                                        )}
                                                    </li>
                                                ))}
                                            </ul>
                                        </td>
                                        <td>{ROLE_TEXT[r.receivedBy][lang]}</td>
                                        <td>
                                            <span class:list={['ambs-pill', `ambs-pill--${RECEIPT_STATUS[r.status].pill}`]}>
                                                {RECEIPT_STATUS[r.status].text[lang]}
                                            </span>
                                            {r.confirmedBy && (
                                                <div class="muted">
                                                    {PT.confirmedBy[lang]}: {ROLE_TEXT[r.confirmedBy][lang]}
                                                </div>
                                            )}
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                )}
            </section>
        )}

        <section class="panel">
            <h2>{PT.trail[lang]}</h2>
            <ol class="trail">
                <li>
                    {PT.created[lang]}: {ROLE_TEXT[o.createdBy][lang]} · <span dir="ltr">{o.createdOn}</span>
                    {o.request && (
                        <span>
                            {' '}
                            · {PT.request[lang]}{' '}
                            <a href={`/${lang}/procurement/requests/`} class="ambs-latin" dir="ltr">
                                {o.request}
                            </a>
                        </span>
                    )}
                </li>
                {o.approvedBy ? (
                    <li>
                        {PT.approved[lang]}: {ROLE_TEXT[o.approvedBy][lang]} · <span dir="ltr">{o.approvedOn}</span>
                    </li>
                ) : o.status === 'cancelled' ? (
                    <li>
                        {PT.cancelledBecause[lang]}: {o.reason?.[lang]}
                    </li>
                ) : (
                    <li>{PT.awaitingApproval[lang]}</li>
                )}
            </ol>
            <p class="muted">{PT.duties[lang]}</p>
        </section>

        <section class="panel panel--quiet">
            <h2>{PT.matchingTitle[lang]}</h2>
            <p>{PT.matchingNote[lang]}</p>
        </section>
    </div>
</AppLayout>

<style>
    h2 {
        margin: 0;
        font-size: 1.125rem;
        color: var(--ambs-brand);
    }
    .back {
        color: var(--ambs-brand);
        font-weight: 700;
        justify-self: start;
        display: inline-flex;
        align-items: center;
        min-height: var(--ambs-touch);
    }
    .phead p {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }
    .totals {
        margin: 0;
        display: grid;
        gap: 6px;
        justify-self: end;
        width: min(100%, 460px);
    }
    .totals div {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 8px 14px;
        border-radius: var(--ambs-radius-sm);
        background: var(--ambs-surface);
        border: 1px solid var(--ambs-line);
    }
    .totals dt small {
        display: block;
        color: var(--ambs-muted);
        font-size: 0.8125rem;
    }
    .totals dd {
        margin: 0;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .totals__vat {
        border-style: dashed !important;
    }
    .totals__total {
        font-weight: 700;
    }
    .panel {
        padding: 20px;
        border-radius: 18px;
        background: var(--ambs-surface);
        border: 1px solid var(--ambs-line);
        display: grid;
        gap: 10px;
    }
    .panel--quiet {
        background: var(--ambs-quiet-bg);
    }
    .panel p {
        margin: 0;
    }
    .trail {
        margin: 0;
        padding-inline-start: 20px;
        display: grid;
        gap: 6px;
    }
    .trail a {
        color: var(--ambs-brand);
        font-weight: 700;
    }
    .muted {
        color: var(--ambs-muted);
        font-size: 0.875rem;
    }
</style>
