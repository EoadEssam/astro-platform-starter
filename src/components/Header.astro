---
import Logo from '../components/Logo.astro';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Revalidation', href: '/revalidation' },
    { linkText: 'Image CDN', href: '/image-cdn' },
    { linkText: 'Edge Function', href: '/edge' },
    { linkText: 'Blobs', href: '/blobs' }
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`));
---

<nav aria-label="Main" class="flex flex-wrap items-center gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <a href="/" aria-label="Home">
        <Logo />
    </a>
    {!!navItems?.length && (
        <ul class="flex flex-wrap gap-x-4 gap-y-1">
            {navItems.map((item) => (
                <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2">
                        {item.linkText}
                    </a>
                </li>
            ))}
        </ul>
    )}
</nav>
