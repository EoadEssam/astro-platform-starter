---
import Logo from '../components/Logo.astro';
import { isDemoEnabled } from '../demo/enabled.mjs';
import { demoNavItems } from '../demo/routes.mjs';

// The application has no pages of its own yet besides Home.
// The links to the template demo only appear while the demo is on, see src/demo/README.md
const navItems = [{ linkText: 'Home', href: '/' }, ...(isDemoEnabled() ? demoNavItems : [])];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`));
---

<nav aria-label="Main" class="flex flex-wrap items-center gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <a href="/" aria-label="Home">
        <Logo />
    </a>
    {!!navItems?.length && (
        <ul class="flex flex-wrap gap-x-4 gap-y-1">
            {navItems.map((item) => (
                <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2">
                        {item.linkText}
                    </a>
                </li>
            ))}
        </ul>
    )}
</nav>
